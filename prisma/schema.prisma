datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SELLER
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String   // Hashed password
  role      Role     @default(SELLER)
  sales     Sale[]
  cashSessions CashSession[]
  auditLogs AuditLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id            String   @id @default(uuid())
  name          String
  sku           String   @unique
  sale_price    Decimal  @db.Decimal(10, 2)
  cost_price    Decimal  @db.Decimal(10, 2) // Sensitive data
  stock_quantity Int      @default(0)
  ncm           String?
  sale_items    SaleItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Customer {
  id              String   @id @default(uuid())
  name            String
  document        String   @unique // CPF/CNPJ
  whatsapp        String?
  credit_limit    Decimal  @db.Decimal(10, 2) @default(0.00)
  current_balance Decimal  @db.Decimal(10, 2) @default(0.00) // For "fiado" management
  data_consent    Boolean  @default(false)
  consent_date    DateTime?
  sales           Sale[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Sale {
  id             String     @id @default(uuid())
  customer       Customer   @relation(fields: [customerId], references: [id])
  customerId     String
  user           User       @relation(fields: [userId], references: [id])
  userId         String     // Seller
  items          SaleItem[]
  payment_method String     // E.g., CASH, CREDIT_CARD, PIX, FIADO
  total_amount   Decimal    @db.Decimal(10, 2)
  dueDate        DateTime?  // Maturity date for FIADO transactions
  createdAt      DateTime   @default(now())
}

model SaleItem {
  id        String  @id @default(uuid())
  sale      Sale    @relation(fields: [saleId], references: [id])
  saleId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2) // Price at the time of sale
}

model CashSession {
  id            String            @id @default(uuid())
  user          User              @relation(fields: [userId], references: [id])
  userId        String
  openedAt      DateTime          @default(now())
  closedAt      DateTime?
  initialAmount Decimal           @db.Decimal(10, 2)
  finalAmount   Decimal?          @db.Decimal(10, 2)
  status        CashSessionStatus @default(OPEN)
}

model AuditLog {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  action    String   // e.g., "PRICE_CHANGE", "HIGH_DISCOUNT"
  details   Json     // Sensitive action details
  createdAt DateTime @default(now())
}

model Settings {
  id                   String   @id @default("global-settings")
  lateFeePercentage    Decimal  @db.Decimal(5, 2) @default(2.00) // Multa por atraso (%)
  monthlyInterestRate  Decimal  @db.Decimal(5, 2) @default(1.00) // Juros de mora mensal (%)
  updatedAt            DateTime @updatedAt
}
