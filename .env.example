# ##########################################################
# PDV CONCEPTION - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ##########################################################

# --- DATABASE CONFIGURATION ---
# Prisma 7.0 requires the URL to be defined here and referenced in prisma.config.ts
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://pdv_user:secure_password@localhost:5432/pdv_conception?schema=public"

# --- AUTHENTICATION & SECURITY ---
# Secret key used to sign JWT tokens (Min 32 characters suggested for security)
JWT_SECRET="generate_a_very_long_random_string_here_for_prod"
JWT_EXPIRES_IN="8h"

# --- WHATSAPP SMART LINK CONFIG ---
# Store info for formatted receipt messages
WHATSAPP_STORE_NAME="PDV CONCEPTION HQ"
WHATSAPP_STORE_PHONE="5535999999999"

# --- FRONTEND & API ENDPOINTS ---
# Base URL for generating digital receipt links and CORS
# MUST USE HTTPS IN PRODUCTION
FRONTEND_URL="https://seu-dominio.com"
API_BASE_URL="https://api.seu-dominio.com"

# --- EXTERNAL INTEGRATIONS ---
# NCM Lookup API (Optional integration for fiscal precision)
# Examples: Cosmos, Arquivei, or Custom Tax API
NCM_API_KEY="your_api_key_here"
NCM_API_URL="https://api.example.com/v1/ncm"

# --- APPLICATION SETTINGS ---
NODE_ENV="development"
PORT=4000
DEBUG=true
MAX_CASH_BREAKAGE_THRESHOLD=50
